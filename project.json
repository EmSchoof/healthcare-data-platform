{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "healthcare-data-platform",
  "root": ".",
  "sourceRoot": ".",
  "projectType": "application",
  "targets": {
    "ingest": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m src.apps.ingestion.ingest_fhir"
      }
    },
    "dbt-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dbt run",
        "cwd": "dbt_project"
      }
    },
    "dbt-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dbt test",
        "cwd": "dbt_project"
      }
    },
    "pipeline": {
      "executor": "nx:run-commands",
      "dependsOn": ["ingest", "dbt-run", "dbt-test"],
      "options": {
        "command": "echo Pipeline complete"
      }
    }
  }
}